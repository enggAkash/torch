<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: illustration on one side, status text and CTA on the other, so the
     button stays on screen instead of being pushed below the fold by the stack. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/torchModeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_margin_horizontal"
    android:paddingEnd="@dimen/screen_margin_horizontal">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/brightNessIv"
            android:layout_width="@dimen/beam_width"
            android:layout_height="@dimen/beam_height"
            android:layout_marginBottom="-8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/flashlight_brightness"
            android:visibility="invisible"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/torchIv"
            android:layout_width="@dimen/illustration_size"
            android:layout_height="@dimen/illustration_size"
            android:contentDescription="@string/cd_flashlight_illustration"
            android:focusable="true"
            android:src="@drawable/ic_flashlight" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="@dimen/mode_controls_width"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/mode_column_gap"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/torchStatusTitleTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:text="@string/flashlight_is_off"
            android:textAppearance="@style/TextAppearance.Torch.StatusTitle" />

        <TextView
            android:id="@+id/torchStatusCaptionTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tap_to_turn_on"
            android:textAppearance="@style/TextAppearance.Torch.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/torchToggleBtn"
            style="@style/Widget.Torch.Button.Cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cta_margin_top"
            android:text="@string/turn_on"
            app:icon="@drawable/ic_power" />
    </LinearLayout>

</LinearLayout>
