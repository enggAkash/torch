<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: illustration on one side, text, speed slider and CTA on the other.
     See layout-land/layout_torch_mode.xml for the reasoning. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/strobeModeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_margin_horizontal"
    android:paddingEnd="@dimen/screen_margin_horizontal">

    <ImageView
        android:id="@+id/strobeIv"
        android:layout_width="@dimen/strobe_circle_size"
        android:layout_height="@dimen/strobe_circle_size"
        android:background="@drawable/bg_circle_soft"
        android:contentDescription="@string/cd_strobe_illustration"
        android:focusable="true"
        android:padding="@dimen/strobe_bolt_padding"
        android:src="@drawable/vector_strobe" />

    <LinearLayout
        android:layout_width="@dimen/mode_controls_width"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/mode_column_gap"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/strobeTitleTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/strobe_mode"
            android:textAppearance="@style/TextAppearance.Torch.StatusTitle" />

        <!-- The portrait caption ("Adjust speed and start") is dropped here: landscape
             has ~half the height and the slider directly below already says it. -->

        <TextView
            android:id="@+id/strobeWarningTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/strobe_warning"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/strobeSpeedLabelTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/speed"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/strobeSpeedValueTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                tools:text="10 flashes / sec" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/strobeSpeedSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/cd_strobe_speed"
            android:saveEnabled="false"
            android:stepSize="1"
            android:value="5"
            android:valueFrom="1"
            android:valueTo="10"
            app:trackColorInactive="@color/slider_track_inactive" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/strobeToggleBtn"
            style="@style/Widget.Torch.Button.Cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/start_strobe"
            app:icon="@drawable/ic_play" />
    </LinearLayout>

</LinearLayout>
