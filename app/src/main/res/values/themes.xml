<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Torch" parent="Theme.Material3.DayNight.NoActionBar" tools:targetApi="q">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <!-- The app pins light mode; without this, OEM force dark inverts our windows -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.Torch" parent="Base.Theme.Torch" />
</resources>
