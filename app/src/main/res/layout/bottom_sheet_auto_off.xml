<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_margin_horizontal"
        android:paddingEnd="@dimen/screen_margin_horizontal"
        android:paddingBottom="12dp"
        android:text="@string/auto_off_label"
        android:textAppearance="@style/TextAppearance.Torch.StatusTitle" />

    <TextView
        android:id="@+id/autoOffNever"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_sheet_option"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/never"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/autoOff5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_sheet_option"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        tools:text="5 min" />

    <TextView
        android:id="@+id/autoOff10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_sheet_option"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        tools:text="10 min" />

    <TextView
        android:id="@+id/autoOff30"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_sheet_option"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        tools:text="30 min" />

    <TextView
        android:id="@+id/autoOffCustom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_sheet_option"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/custom"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

</LinearLayout>
